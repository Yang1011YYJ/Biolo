  m_text: "\u3010\u907A\u50B3\u56E0\u5B50\u8207\u7B26\u865F\u3011\n\u672C\u6B21\u5BE6\u9A57\u4F7F\u7528 T\u3001t \u8868\u793A\u5F71\u97FF\u8C4C\u8C46\u8396\u9AD8\u7684\u4E00\u5C0D\u7B49\u4F4D\u57FA\u56E0\u3002T \u70BA\u986F\u6027\uFF0Ct \u70BA\u96B1\u6027\u3002\n\n\u3010\u57FA\u56E0\u578B\u8207\u8868\u73FE\u578B\u3011\n\u57FA\u56E0\u578B\u662F\u7B49\u4F4D\u57FA\u56E0\u7684\u7D44\u5408\uFF0C\u4F8B\u5982 TT\u3001Tt\u3001tt\u3002\n\u8868\u73FE\u578B\u662F\u53EF\u4EE5\u89C0\u5BDF\u5230\u7684\u6027\u72C0\uFF0C\u4F8B\u5982\u9AD8\u8396\u3001\u77EE\u8396\u3002\n\n\u5728\u672C\u6B21\u8C4C\u8C46\u8396\u9AD8\u7684\u5B8C\u5168\u986F\u6027\u6A21\u578B\u4E2D\uFF1A\nTT\uFF1A\u9AD8\u8396\nTt\uFF1A\u9AD8\u8396\ntt\uFF1A\u77EE\u8396\n\n\u3010\u89AA\u4EE3\u5982\u4F55\u50B3\u905E\u907A\u50B3\u56E0\u5B50\u3011\n\u5F62\u6210\u751F\u6B96\u7D30\u80DE\u6642\uFF0C\u4E00\u5C0D\u7B49\u4F4D\u57FA\u56E0\u6703\u5206\u958B\uFF0C\u6BCF\u500B\u751F\u6B96\u7D30\u80DE\u53EA\u5E36\u6709\u5176\u4E2D\u4E00\u500B\u3002\n\u56E0\u6B64\uFF0CTt \u89AA\u4EE3\u53EF\u5F62\u6210\u5E36\u6709 T \u6216 t \u7684\u751F\u6B96\u7D30\u80DE\uFF0C\u5169\u7A2E\u6A5F\u7387\u5404\u70BA\u4E8C\u5206\u4E4B\u4E00\u3002\n\n\u5B50\u4EE3\u5206\u5225\u5F9E\u5169\u500B\u89AA\u4EE3\u5404\u53D6\u5F97\u4E00\u500B\u7B49\u4F4D\u57FA\u56E0\uFF0C\u7D44\u6210\u81EA\u5DF1\u7684\u57FA\u56E0\u578B\u3002"
